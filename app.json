{
  "expo": {
    "jsEngine": "hermes",
    "name": "TiltPay",
    "displayName": "TiltPay",
    "slug": "tiltpay",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/logo-app-ios.png",
    "splash": {
      "image": "./assets/loading-screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCFCFC"
    },
    "ios": {
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "bundleIdentifier": "com.tilt.pay"
    },
    "android": {
      "package": "com.tilt.pay",
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true,
      "splash": {
        "image": "./assets/loading-screen.png",
        "resizeMode": "contain",
        "backgroundColor": "#FCFCFC"
      },
      "permissions": [
        "android.permission.NFC"
      ]
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "45fa38f8-df16-4bde-bdd3-bda375b63e92"
      }
    },
    "owner": "2fl00rian6"
  }
}
